# ---------------------------------------------------------------------------
# MailPostA — copy to .env and fill in. Never commit .env.
# Write values without surrounding quotes: podman passes them through literally.
# Sending is disabled for every account (no SMTP): drafts only.
# ---------------------------------------------------------------------------

# Your accounts, comma separated. Names are yours to pick: lowercase letters and
# digits. Each one becomes `bin/mail -a <name>` (local copy) and `-a <name>-cloud`
# (live server). The first one is the default.
ACCOUNTS=personal,side,work

# Per account: <NAME>_TYPE is gmail or outlook, plus the settings below.
# Everything not listed (server, folders) has a sensible default for the type.

# ----- personal (Gmail) -----------------------------------------------------
PERSONAL_TYPE=gmail
PERSONAL_ADDRESS=you@gmail.com
PERSONAL_DISPLAY_NAME=Your Name
# An App Password (https://myaccount.google.com/apppasswords), not your login password.
PERSONAL_PASSWORD=change-me

# ----- side (another Gmail) -------------------------------------------------
SIDE_TYPE=gmail
SIDE_ADDRESS=you.side@gmail.com
SIDE_DISPLAY_NAME=Your Name
SIDE_PASSWORD=change-me

# ----- work (Outlook / Microsoft 365) ---------------------------------------
# Signs in with OAuth (no password). After `docker compose up -d`, run once:
#   bin/mail --tool oauth-token login work
WORK_TYPE=outlook
WORK_ADDRESS=you@company.com
WORK_DISPLAY_NAME=Your Name

# ----- Optional per-account overrides (defaults shown) ----------------------
# gmail:   <NAME>_SYNC_PATTERNS=INBOX "[Gmail]/Sent Mail" "[Gmail]/Drafts"   (mbsync Patterns; don't add "[Gmail]/All Mail")
#          <NAME>_DELETE_FOLDERS=[Gmail]/All Mail             (comma separated; searched by delete-both)
#          <NAME>_TRASH_FOLDER=[Gmail]/Trash
#          <NAME>_DRAFTS_FOLDER=[Gmail]/Drafts
#          <NAME>_IMAP_HOST=imap.gmail.com   <NAME>_IMAP_PORT=993
# outlook: <NAME>_SYNC_PATTERNS=INBOX "Sent Items" Drafts
#          <NAME>_DELETE_FOLDERS=INBOX,Sent Items,Archive
#          <NAME>_TRASH_FOLDER=Deleted Items
#          <NAME>_DRAFTS_FOLDER=Drafts
#          <NAME>_IMAP_HOST=outlook.office365.com   <NAME>_IMAP_PORT=993
#          <NAME>_OAUTH_CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753   (Thunderbird's public client;
#                                  use your org's app registration if IT requires it)
#          <NAME>_OAUTH_TENANT=organizations   (or your tenant ID/domain)

# ----- Shared ---------------------------------------------------------------
# Local retention (days). Older local copies are deleted; the server is never touched by pruning.
RETENTION_DAYS=60
# Seconds between sync runs (900 = every 15 minutes). Each run only fetches what is new.
SYNC_INTERVAL=900
# Only sync between these local hours (TZ below), e.g. 7-22 = 7:00 to 22:00, 22-6 = overnight.
# Empty = around the clock. Outside the hours the container sleeps; local mail and the web UI still work.
SYNC_HOURS=
# Days to keep logs in data/logs (sync log, per-run reports, bin/mail audit log).
LOG_RETENTION_DAYS=30
# Timezone for log timestamps, run reports and email dates (Arizona: no daylight saving).
TZ=America/Phoenix

# ----- Web UI login (Caddy's popup) -----------------------------------------
# The password is stored only as a bcrypt hash, never in plain text.
# 1. Paste this command exactly as it is (Docker: docker instead of podman). Do NOT put your password in it:
#      podman run --rm -it docker.io/library/caddy:2.11.7-alpine sh -c 'h=$(caddy hash-password) && printf "MAILPOSTA_LOGIN_HASH=\047%s\047\n" "$h"'
#    It then asks; type the password at the prompts (nothing shows; use 12+ characters):
#      Enter password:      <- your password, Enter
#      Confirm password:    <- the same again, Enter
#      MAILPOSTA_LOGIN_HASH='$2a$14$...'    <- the finished line, quotes included: copy all of it
# 2. Paste that line over MAILPOSTA_LOGIN_HASH= below, and set your username in MAILPOSTA_LOGIN_USER=
#    (this is the one value that keeps its quotes: they stop the $ signs from being read as variables)
# 3. Restart so the login uses it: docker compose up -d
# Without both, compose refuses to start, so your mail is never served without the login.
# To change the password (or if you forgot it): run the command in step 1 again, paste the new line over
# MAILPOSTA_LOGIN_HASH= below, then docker compose up -d. The old password stops working right away.
MAILPOSTA_LOGIN_USER=admin
MAILPOSTA_LOGIN_HASH=
# Web UI address: http://127.0.0.1:17203 (this machine only). For your local network: MAILPOSTA_BIND=0.0.0.0
# (plain HTTP: fine at home; from outside, use a VPN).
# Image for the mail and web containers. Empty = the published one, ghcr.io/adrielleu/mailposta:latest
# (amd64 + arm64). Pin a version with e.g. ghcr.io/adrielleu/mailposta:0.2 (fixes only) or :0.2.1 (exact).
# Update: docker compose pull && docker compose up -d. (Building from source: see docker-compose.build.yml.)
MAILPOSTA_IMAGE=
MAILPOSTA_PORT=17203
MAILPOSTA_BIND=127.0.0.1
