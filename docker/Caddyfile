# Caddy in front of the MailPostA web UI (docker-compose.yml, service login): the browser's login popup,
# then everything passes through to the web UI, which has no login of its own.
#
# Mounted into the official Caddy image as /etc/caddy/Caddyfile. The login comes from .env
# (MAILPOSTA_LOGIN_USER and MAILPOSTA_LOGIN_HASH, a bcrypt hash; .env.example shows how to make it),
# passed in by docker-compose.yml, which refuses to start without them, so your mail is never served
# without the login.
#
# Caddy shares the web container's network, so the UI is at 127.0.0.1:8080 and only Caddy's port 80 is
# published (host port 17203).
{
	admin off
	auto_https off
}

:80 {
	basic_auth {
		{$MAILPOSTA_LOGIN_USER} {$MAILPOSTA_LOGIN_HASH}
	}

	header {
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy 127.0.0.1:8080
}
