#!/usr/bin/env python3
"""Resolves the accounts in the environment and renders the configs.

Accounts come from ACCOUNTS=name1,name2,... with per-account variables
<NAME>_TYPE (gmail | outlook), <NAME>_ADDRESS, ... (see .env.example). Without
ACCOUNTS, the older GMAIL_* / WORK_* layout is read as accounts "gmail" (type
gmail) and "work" (type outlook).

Writes:
  ~/.config/emailassist/accounts.json   resolved non-secret settings, read by
                                        delete-both and oauth-token
  ~/.mbsyncrc, ~/.config/himalaya/config.toml
and prints the account names, space separated, for the entrypoint.

Secrets are never written: the rendered configs fetch them at runtime
(printenv <NAME>_PASSWORD / oauth-token <name>).
"""
import json
import os
import re
import sys
from pathlib import Path
from string import Template

TEMPLATES = Path("/templates")
ACCOUNTS_FILE = Path.home() / ".config/emailassist/accounts.json"

DEFAULTS = {
    "gmail": {
        "imap_host": "imap.gmail.com",
        "imap_port": "993",
        "sync_patterns": 'INBOX "[Gmail]/Sent Mail"',
        "delete_folders": "[Gmail]/All Mail",
        "trash_folder": "[Gmail]/Trash",
        "drafts_folder": "[Gmail]/Drafts",
    },
    "outlook": {
        "imap_host": "outlook.office365.com",
        "imap_port": "993",
        "sync_patterns": 'INBOX "Sent Items"',
        "delete_folders": "INBOX,Sent Items,Archive",
        "trash_folder": "Deleted Items",
        "drafts_folder": "Drafts",
        # Thunderbird's public client; override with your org's app registration.
        "oauth_client_id": "9e5f94bc-e8a4-4e73-b8be-63364c29d753",
        "oauth_tenant": "organizations",
    },
}
LEGACY_TYPES = {"gmail": "gmail", "work": "outlook"}

NOTMUCH_CONFIG = """[database]
path=/index
mail_root=/mail

[user]
name={name}
primary_email={primary}
other_email={others}

[new]
tags=new;
ignore=.uidvalidity;.mbsyncstate;.mbsyncstate.journal;.mbsyncstate.new;.mbsyncstate.lock

[maildir]
synchronize_flags=false

[index]
header.List=List-Id
"""


def fail(message):
    sys.exit(f"configure: {message}")


def account_names():
    if os.environ.get("ACCOUNTS"):
        names = [n.strip() for n in os.environ["ACCOUNTS"].split(",") if n.strip()]
    else:
        names = [n for n in LEGACY_TYPES if os.environ.get(f"{n.upper()}_ADDRESS")]
    if not names:
        fail("set ACCOUNTS (and the per-account variables) in .env")
    for name in names:
        # Lowercase letters/digits only: it becomes a directory, an env prefix,
        # and a himalaya account name (with "-cloud" appended for the live one).
        if not re.fullmatch(r"[a-z][a-z0-9]*", name):
            fail(f"account name {name!r} must be lowercase letters and digits, starting with a letter")
    if len(set(names)) != len(names):
        fail("duplicate account names in ACCOUNTS")
    return names


def resolve(name):
    prefix = name.upper()
    env = lambda key: os.environ.get(f"{prefix}_{key.upper()}", "").strip()
    kind = env("type") or (LEGACY_TYPES.get(name) if not os.environ.get("ACCOUNTS") else "")
    if kind not in DEFAULTS:
        fail(f"set {prefix}_TYPE to gmail or outlook")
    if not env("address"):
        fail(f"set {prefix}_ADDRESS")
    if kind == "gmail" and not env("password"):
        fail(f"set {prefix}_PASSWORD (a Gmail app password)")
    account = {"name": name, "prefix": prefix, "type": kind,
               "address": env("address"), "display_name": env("display_name")}
    for key, default in DEFAULTS[kind].items():
        account[key] = env(key) or default
    return account


def toml_str(value):
    return json.dumps(value)  # a JSON string is a valid TOML basic string


def main():
    accounts = [resolve(n) for n in account_names()]
    ACCOUNTS_FILE.parent.mkdir(parents=True, exist_ok=True)
    ACCOUNTS_FILE.write_text(json.dumps(accounts, indent=2))

    mbsync = []
    himalaya = [(TEMPLATES / "himalaya-base.tmpl").read_text()]
    for i, a in enumerate(accounts):
        values = dict(a, default="true" if i == 0 else "false",
                      **{f"q_{k}": toml_str(v) for k, v in a.items()})
        mbsync.append(Template((TEMPLATES / f"mbsync-{a['type']}.tmpl").read_text()).substitute(values))
        himalaya.append(Template((TEMPLATES / f"himalaya-{a['type']}.tmpl").read_text()).substitute(values))
        for d in (f"/mail/{a['name']}", f"/state/{a['name']}"):
            Path(d).mkdir(parents=True, exist_ok=True)

    Path.home().joinpath(".mbsyncrc").write_text("\n".join(mbsync))
    # notmuch: index of all local copies for tags/search. Its database lives in
    # /index (data/index, which the web UI reads); maildir flags are left alone so
    # tags never rename mail files.
    Path.home().joinpath(".notmuch-config").write_text(NOTMUCH_CONFIG.format(
        primary=accounts[0]["address"],
        others=";".join(a["address"] for a in accounts[1:]),
        name=accounts[0]["display_name"] or accounts[0]["address"]))
    himalaya_cfg = Path.home() / ".config/himalaya/config.toml"
    himalaya_cfg.parent.mkdir(parents=True, exist_ok=True)
    himalaya_cfg.write_text("\n".join(himalaya))
    print(" ".join(a["name"] for a in accounts))


if __name__ == "__main__":
    main()
