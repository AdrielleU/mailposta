JS = """
function copyText(t){
  if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(t);
  // Plain-HTTP fallback (the clipboard API needs HTTPS or localhost)
  const ta = document.createElement('textarea'); ta.value = t; ta.style.position = 'fixed'; ta.style.opacity = '0';
  document.body.appendChild(ta); ta.select();
  try { document.execCommand('copy'); } finally { ta.remove(); }
  return Promise.resolve();
}
document.addEventListener('click', ev => {
  const b = ev.target.closest('[data-copy-text],[data-copy-from]');
  if (!b) return;
  const text = b.dataset.copyFrom ? document.querySelector(b.dataset.copyFrom).innerText : b.dataset.copyText;
  copyText(text).then(() => { const old = b.textContent; b.textContent = 'Copied'; setTimeout(() => b.textContent = old, 1200); });
});
"""

# ---------------------------------------------------------------- server

SECURITY_HEADERS = {
    "Content-Security-Policy": "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; "
                               "form-action 'self'; base-uri 'none'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Cache-Control": "no-store",
}


class Handler(BaseHTTPRequestHandler):
    server_version = "mailposta"
    sys_version = ""

    def send(self, status, body, ctype="text/html; charset=utf-8", extra=None):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(status)
        for k, v in {**SECURITY_HEADERS, "Content-Type": ctype, "Content-Length": str(len(data)), **(extra or {})}.items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        u = urllib.parse.urlsplit(self.path)
        params = dict(urllib.parse.parse_qsl(u.query))
        p = u.path
        try:
            if p == "/":
                return self.send(200, view_overview())
            if p == "/m":
                return self.send(200, view_list(params))
            if p.startswith("/v/"):
                out = view_message(p[3:])
                return self.send(200, out) if out else self.not_found()
            if p.startswith("/raw/"):
                path = msg_path(p[5:])
                if not path:
                    return self.not_found()
                extra = {"Content-Disposition": 'attachment; filename="message.eml"'} if params.get("download") else {}
                return self.send(200, path.read_bytes(), "text/plain; charset=utf-8", extra)
            if p.startswith("/att/"):
                token, _, n = p[5:].partition("/")
                path = msg_path(token)
                found = attachment(path, int(n)) if path and n.isdigit() else None
                if not found:
                    return self.not_found()
                name = re.sub(r"[^\w.\- ]+", "_", found[0])[:150] or "attachment"
                return self.send(200, found[1], "application/octet-stream",
                                 {"Content-Disposition": f'attachment; filename="{name}"'})
            if p == "/runs":
                return self.send(200, view_runs())
            if p == "/logs":
                return self.send(200, view_logs())
            if p.startswith("/logs/"):
                out = view_logs(p[6:])
                return self.send(200, out) if out else self.not_found()
            if p == "/rules":
                return self.send(200, view_rules())
            if p.startswith("/signin/"):
                out = view_signin(p[8:])
                return self.send(200, out) if out else self.not_found()
            if p == "/static/app.css":
                return self.send(200, CSS, "text/css; charset=utf-8")
            if p in ("/static/logo.svg", "/favicon.ico"):
                return self.send(200, LOGO_SVG, "image/svg+xml")
            if p == "/static/app.js":
                return self.send(200, JS, "text/javascript; charset=utf-8")
            return self.not_found()
        except Exception as exc:  # show a plain error page rather than dropping the connection
            self.log_error("error on %s: %r", p, exc)
            return self.send(500, page("Error", f"<h1>Something went wrong</h1><pre class=\"body\">{e(repr(exc))}</pre>"))

    def not_found(self):
        self.send(404, page("Not found", '<h1>Not found</h1><p><a href="/">Back to the overview</a></p>'))

    def same_origin(self):
        # Basic-auth credentials ride along on cross-site form posts too, so only accept our own pages.
        site = self.headers.get("Sec-Fetch-Site")
        if site is not None:
            return site == "same-origin"
        origin, host = self.headers.get("Origin"), self.headers.get("Host")
        return bool(origin and host) and urllib.parse.urlsplit(origin).netloc == host

    def do_POST(self):
        # The only POSTs: /signin/<account> and /check/<account>, which ask the mail container to act.
        p = urllib.parse.urlsplit(self.path).path
        self.rfile.read(min(int(self.headers.get("Content-Length") or 0), 4096))
        kind, _, acct = p.strip("/").partition("/")
        if kind not in ("signin", "check"):
            return self.send(405, "read-only", "text/plain")
        if not self.same_origin():
            return self.send(403, "refused: not sent from this site", "text/plain")
        known = signin_states() if kind == "signin" else check_states()
        if not ACCOUNT_NAME.fullmatch(acct) or acct not in known:
            return self.not_found()
        try:
            tmp = CONTROL_REQUESTS / f".{kind}-{acct}.{threading.get_ident()}"
            tmp.write_text("")
            os.replace(tmp, CONTROL_REQUESTS / f"{kind}-{acct}")
        except OSError as exc:
            self.log_error("%s request for %s failed: %r", kind, acct, exc)
            return self.send(500, page("Error", "<h1>Couldn't send the request</h1><p>The web UI can't write to "
                                                "<code>data/control/requests</code>. Run <code>bin/setup</code>, then "
                                                "<code>docker compose up -d</code>.</p>"))
        self.send(303, "", "text/plain", {"Location": f"/signin/{acct}" if kind == "signin" else "/"})

    def do_PUT(self):
        self.send(405, "read-only", "text/plain")

    do_DELETE = do_PATCH = do_PUT

    def log_message(self, fmt, *args):
        # Paths only (no query strings: searches can contain email content).
        print(f"[{datetime.now().astimezone().isoformat(timespec='seconds')}] {self.command} "
              f"{urllib.parse.urlsplit(self.path).path} {args[1] if len(args) > 1 else ''}", flush=True)


def main():
    Path("/tmp/notmuch-config").write_text(f"[database]\npath={INDEX}\nmail_root={MAIL}\n")
    server = ThreadingHTTPServer(("127.0.0.1", 8080), Handler)
    print("MailPostA web UI on 127.0.0.1:8080 (behind the Caddy login)", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
